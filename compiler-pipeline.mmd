flowchart LR
    subgraph Frontend["ONS React frontend"]
        G["GraphEditor\nLD / FBD JSON"]
        S["MonacoEditor\nSCL / ST text"]
        D["DataBlockEditor\nDB JSON"]
        H["HmiEditor\nHMI JSON"]
    end

    API["ONSBackend\nPOST /api/projects/:id/build"]

    subgraph Compiler["Compiler service / worker"]
        PARSE["Parsers and\neditor adapters"]
        IR["Common IR\nPOUs, types, networks, source spans"]
        CHECK["Semantic validation\nlimits, types, safety rules"]
        PLCOPEN["PLCOpen XML\nserializer"]
        PLCGEN["PLC codegen"]
        ROBOTGEN["Robot C/C++\ncodegen"]
        HMIGEN["HMI C/C++\nresource codegen"]
    end

    MATIEC["matiec\nIEC 61131-3 -> C"]
    ARTIFACT["Build artifact\nC/C++ + manifest + diagnostics\nchecksums + source maps"]
    GATEWAY["Controller gateway\nvalidate / deploy"]
    CONTROLLER["Linux + FPGA controller"]

    G --> API
    S --> API
    D --> API
    H --> API
    API --> PARSE --> IR --> CHECK
    CHECK --> PLCOPEN --> MATIEC --> PLCGEN
    CHECK --> ROBOTGEN
    CHECK --> HMIGEN
    PLCGEN --> ARTIFACT
    ROBOTGEN --> ARTIFACT
    HMIGEN --> ARTIFACT
    ARTIFACT --> GATEWAY --> CONTROLLER
    CHECK -. diagnostics + source spans .-> API
    API -. diagnostics .-> Frontend