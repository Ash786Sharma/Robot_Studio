    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.1",
    "eslint": "^10.4.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
